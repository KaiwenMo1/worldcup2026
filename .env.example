BALLDONTLIE_API_KEY=your_api_key_here
WORLD_CUP_API_BASE_URL=https://api.balldontlie.io/fifa/worldcup/v1

# Optional one-time bookmaker odds snapshot for the Market Edge and Analyst Brief panels.
THE_ODDS_API_KEY=
THE_ODDS_SPORT=soccer_fifa_world_cup
THE_ODDS_REGIONS=us,uk,eu
THE_ODDS_BOOKMAKERS=

# Optional observed lineups, formations, and sidelined-player feed.
SPORTMONKS_API_TOKEN=
SPORTMONKS_API_BASE_URL=https://api.sportmonks.com/v3/football

# Optional provider-independent live event endpoint. The response may be a list
# of event rows or an object containing `events` / `data`.
WORLD_CUP_EVENT_FEED_URL=
WORLD_CUP_EVENT_FEED_API_KEY=

# Optional advanced context refresh.
# StatsBomb Open Data and Open-Meteo historical weather do not need API keys.
STATSBOMB_COMPETITION_ID=43
STATSBOMB_SEASON_ID=106

# Optional OpenAI-compatible model for Intelligence Desk synthesis.
# Ollama example: WORLD_CUP_AI_BASE_URL=http://127.0.0.1:11434/v1
WORLD_CUP_AI_BASE_URL=
WORLD_CUP_AI_MODEL=
WORLD_CUP_AI_API_KEY=

# Optional real multi-model Prediction Arena. Each api_key_env names an
# environment variable that contains the provider key; never place keys here.
# WORLD_CUP_ARENA_MODELS_JSON=[{"provider_name":"OpenAI","model":"MODEL_NAME","base_url":"https://api.openai.com/v1","api_key_env":"OPENAI_API_KEY"}]
# GROQ_API_KEY=
# WORLD_CUP_ARENA_MODELS_JSON=[{"provider_name":"Groq GPT-OSS","model":"openai/gpt-oss-120b","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY"},{"provider_name":"Groq Llama","model":"llama-3.3-70b-versatile","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY"},{"provider_name":"Groq Qwen","model":"qwen/qwen3-32b","base_url":"https://api.groq.com/openai/v1","api_key_env":"GROQ_API_KEY"}]
WORLD_CUP_ARENA_MODELS_JSON=
